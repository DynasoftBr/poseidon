{
    "name": "@poseidon/server",
    "version": "1.0.0",
    "private": true,
    "main": "./dist/index.js",
    "scripts": {
        "dev": "tsx src/index.ts",
        "build": "tsc -b tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "start": "node dist/index.js",
        "typecheck": "tsc -b --emitDeclarationOnly",
        "lint": "eslint .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@poseidon/data-access": "*",
        "@poseidon/runtime": "*",
        "@poseidon/service-utils": "*",
        "dotenv": "^17.2.0",
        "express": "^5.1.0"
    }
}
