{
    "name": "@poseidon/runtime",
    "version": "1.0.0",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc -b tsconfig.build.json && tsc-alias -p tsconfig.build.json",
        "typecheck": "tsc -b --emitDeclarationOnly && tsc -p tests/tsconfig.json",
