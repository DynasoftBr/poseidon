        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "@poseidon/framework": "*",
        "mongodb": "^6.20.0"
    }
}
