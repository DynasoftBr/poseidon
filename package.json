{
    "name": "poseidon",
    "version": "1.0.0",
    "private": true,
    "description": "Self-describing business application runtime",
    "packageManager": "npm@10.8.2",
    "workspaces": [
        "projects/packages/*",
        "projects/poseidon/*"
    ],
    "scripts": {
        "dev": "npm run build:packages && npm run dev -w @poseidon/server",
        "dev:stack": "concurrently -k -n mongo,server -c green,cyan \"npm run dev:infra\" \"npm run dev\"",
        "dev:infra": "docker compose up",
        "build:packages": "turbo run build --filter='./projects/packages/*'",
        "build": "turbo run build",
        "lint": "eslint .",
        "verify": "npm run lint && tsc -p projects/poseidon/portal/tsconfig.json && turbo run typecheck lint test:coverage --output-logs=errors-only",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,js,json,md,yml,yaml}": "eslint --fix"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/express": "^5.0.3",
        "@types/node": "^20.0.0",
        "@types/supertest": "^7.2.0",
        "@vitest/coverage-v8": "^4.0.18",
        "concurrently": "^8.2.2",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-check-file": "^3.3.1",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsonc": "^3.1.2",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-sonarjs": "^4.0.0",
        "husky": "^9.1.7",
        "jiti": "^2.6.1",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.1",
        "supertest": "^7.2.2",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.0.0",
        "turbo": "^2.9.7",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1",
        "vite": "^7.3.6",
        "vitest": "^4.0.18"
    }
}
